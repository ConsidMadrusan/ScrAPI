{
  "openapi": "3.1.0",
  "info": {
    "title": "Todo API",
    "version": "1.0.0",
    "description": "Small 3.1 sample: the todo API with 3.1 features (type lists, const, $defs, $ref with siblings, numeric exclusiveMinimum, a path item in components.pathItems, and a webhook)."
  },
  "servers": [
    {
      "url": "https://todo.example.com"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "todos"
    }
  ],
  "paths": {
    "/todos": {
      "get": {
        "tags": [
          "todos"
        ],
        "operationId": "listTodos",
        "summary": "List todos",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TodoStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "All todos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "todos"
        ],
        "operationId": "createTodo",
        "summary": "Create a todo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewTodo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created todo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            }
          }
        }
      }
    },
    "/todos/{todoId}": {
      "$ref": "#/components/pathItems/TodoItem"
    }
  },
  "components": {
    "schemas": {
      "TodoStatus": {
        "type": "string",
        "enum": [
          "open",
          "done"
        ]
      },
      "NewTodo": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "$ref": "#/components/schemas/TodoStatus",
            "description": "Current status"
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "priority": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 5
          },
          "kind": {
            "const": "todo"
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NewTodo/$defs/Label"
            }
          }
        },
        "$defs": {
          "Label": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "color": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "Todo": {
        "allOf": [
          {
            "$ref": "#/components/schemas/NewTodo"
          },
          {
            "type": "object",
            "required": [
              "id",
              "createdAt"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "pathItems": {
      "TodoItem": {
        "parameters": [
          {
            "name": "todoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "get": {
          "tags": [
            "todos"
          ],
          "operationId": "getTodo",
          "summary": "Get a todo",
          "responses": {
            "200": {
              "description": "The todo",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              }
            }
          }
        },
        "put": {
          "tags": [
            "todos"
          ],
          "operationId": "updateTodo",
          "summary": "Replace a todo",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewTodo"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "The updated todo",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              }
            }
          }
        },
        "delete": {
          "tags": [
            "todos"
          ],
          "operationId": "deleteTodo",
          "summary": "Delete a todo",
          "responses": {
            "204": {
              "description": "Deleted"
            }
          }
        }
      }
    }
  },
  "webhooks": {
    "todoCreated": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Todo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
