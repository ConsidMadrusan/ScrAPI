# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build and cache output
/.next/
/out/

# Production build output
/build
/dist

# Test coverage
/coverage

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files (a future .env.example stays tracked)
.env
.env.*
!.env.example

# TypeScript incremental build artifacts
*.tsbuildinfo

# Vercel local metadata
.vercel

# OS-specific clutter
.DS_Store
Thumbs.db
desktop.ini

# Editor-specific files
*.swp
.idea/

# ScrAPI generation artifacts.
# Generation should use per-request OS temp directories; these patterns guard
# against local development output accidentally landing in the repository.
/.scrapi-tmp/
/tmp/
/generated-output/
/scrapi-*.zip

# Private implementation notes; kept locally only.
/docs/implementation.md

# next-env.d.ts is intentionally NOT ignored; it stays tracked unless the
# implementation documents a reason to change that.
